# Copy to .env (never commit .env)
# Get API key: https://bailian.console.aliyun.com/

# Paper-aligned defaults (override for DashScope / local dev)
# KARMA_EMBEDDING_MODEL=text-embedding-3-large
# DASHSCOPE_CHAT_MODEL=gpt-4o
# DASHSCOPE_VISION_MODEL=gpt-4o

DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.5-omni-flash
DASHSCOPE_VISION_MODEL=qwen3.5-omni-flash

# Optional overrides (auto-detected from repo layout if unset)
# KARMA_ROOT=.
HF_ENDPOINT=https://hf-mirror.com

# Optional Weights & Biases (for --env.wandb_mode online|offline)
# WANDB_API_KEY=your-wandb-key
# WANDB_BASE_URL=https://api.wandb.ai
